<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Netvisor purchase invoice XML document
    -->
    <template id="netvisor_purchaseinvoice">
        <root>
            <purchaseInvoice>
                <invoiceNumber t-esc="invoice.name or ''" />
                <invoiceDate
                    format="ansi"
                    t-esc="invoice.invoice_date.isoformat() or ''"
                />
                <invoiceSource>manual</invoiceSource>
                <eventDate
                    format="ansi"
                    t-esc="invoice.date.isoformat() or ''"
                />
                <dueDate
                    format="ansi"
                    t-esc="invoice.invoice_date_due.isoformat() or ''"
                />

                <vendorName t-esc="invoice.partner_id.name or ''" />
                <t t-set="street" t-value="invoice.partner_id.street or ''" />
                <t t-set="street2" t-value="invoice.partner_id.street2 or ''" />
                <vendorAddressLine t-esc="street + ' ' + street2" />
                <vendorPostNumber t-esc="invoice.partner_id.zip or ''" />
                <vendorCity t-esc="invoice.partner_id.city or ''" />
                <vendorCountry
                    t-esc="invoice.partner_id.country_id.code or ''"
                />
                <vendorPhoneNumber t-esc="invoice.partner_id.phone or ''" />
                <vendoremail t-esc="invoice.partner_id.email or ''" />
                <vendorHomePage t-esc="invoice.partner_id.website or ''" />

                <amount t-esc="-invoice.amount_total_signed or 0" />
                <accountNumber
                    t-esc="invoice.partner_bank_id.sanitized_acc_number or ''"
                />
                <overdueFinePercent t-esc="invoice.overdue_interest or 0" />
                <bankReferencenumber t-esc="invoice.payment_reference or ''" />

                <ourReference t-esc="invoice.ref" />
                <!--<yourReference t-esc="" />-->

                <currencyCode t-esc="invoice.currency_id.name" />
                <deliveryTerms t-esc="invoice.narration_plaintext" />
                <comment t-esc="invoice.description" />

                <t
                    t-set="invoice_lines"
                    t-value="invoice.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"
                />
                <t
                    t-set="comment_lines"
                    t-value="invoice.invoice_line_ids.filtered(lambda l: l.display_type != 'product')"
                />
                <purchaseInvoiceLines>
                    <purchaseInvoiceLine t-foreach="invoice_lines" t-as="line">
                        <!-- Normal invoice lines -->
                        <productCode
                            t-esc="line.product_id.default_code or ''"
                        />
                        <productName
                            t-esc="line.name and line.name[0:200] or ''"
                        />
                        <!-- Negative quantity for refunds -->
                        <deliveredAmount
                            t-esc="line.quantity if invoice.move_type != 'in_refund' else line.quantity * -1"
                        />
                        <unitPrice t-esc="line.price_total / line.quantity" />
                        <discountPercentage t-esc="line.discount" />
                        <vatPercent
                            t-esc="sum(line.mapped('tax_ids.amount'))"
                        />
                        <lineSum
                            type="brutto"
                            t-esc="round(line.price_total, 2)"
                        />
                        <description t-esc="line.name" />
                        <accountingSuggestion
                            t-esc="line.account_id.code or ''"
                        />

                        <t
                            t-if="line.analytic_distribution"
                            id="dimension_wrapper"
                        >
                        <dimension
                                t-foreach="list(line.analytic_distribution.keys())[0].split(',')"
                                t-as="dimension"
                            >
                            <dimensionName
                                    t-esc="dimensions[int(dimension)][0] or ''"
                                />
                            <dimensionItem
                                    t-esc="dimensions[int(dimension)][1] or ''"
                                />
                        </dimension>
                        </t>
                    </purchaseInvoiceLine>
                </purchaseInvoiceLines>
                <purchaseInvoiceCommentLines t-if="comment_lines">
                    <purchaseInvoiceCommentLine
                        t-foreach="comment_lines"
                        t-as="line"
                    >
                        <!-- Comment lines -->
                        <t t-if="line.display_type != 'product'">
                            <comment t-esc="line.name or ''" />
                        </t>
                    </purchaseInvoiceCommentLine>
                </purchaseInvoiceCommentLines>

                <purchaseInvoiceAttachments t-if="invoice.attachment_ids">
                    <t t-foreach="invoice.attachment_ids" t-as="attachment">
                        <!-- Skip unsupported file types -->
                        <t
                            t-set="file_ending"
                            t-value="attachment.mimetype.split('/')[1]"
                        />
                        <purchaseinvoiceattachment
                            t-if="file_ending in ['pdf','doc','xls','tif','jpg','gif','txt','xsl','html']"
                        >
                            <mimeType t-esc="attachment.mimetype" />
                            <attachmentDescription
                                t-esc="attachment.description or attachment.name"
                            />
                            <fileName t-esc="attachment.name" />
                            <documentData
                                t-att-type="file_ending"
                                t-raw="attachment.datas_utf8"
                            />
                        </purchaseinvoiceattachment>
                    </t>
                </purchaseInvoiceAttachments>
            </purchaseInvoice>
        </root>
    </template>
</odoo>
