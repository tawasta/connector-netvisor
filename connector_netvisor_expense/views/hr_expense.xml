<?xml version="1.0" ?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form.netvisor</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_submit_expenses']" position="after">
                <button
                    name="action_netvisor_export_record"
                    type="object"
                    class="oe_highlight"
                    string="Send to Netvisor"
                    invisible="netvisor_bind_ids or state not in ['approved', 'done']"
                />
            </xpath>

            <field name="description" position="after">
                <label for="netvisor_bind_ids" invisible="not netvisor_bind_ids" />
                <field
                    name="netvisor_bind_ids"
                    nolabel="1"
                    invisible="not netvisor_bind_ids"
                >
                    <tree create="false" delete="false">
                        <field name="backend_id" readonly="1" />
                        <field name="odoo_id" readonly="1" />
                        <field name="external_id" readonly="1" />
                    </tree>
                </field>
            </field>
        </field>
    </record>
</odoo>
