<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Sale invoices -->
    <record id="job_function_netvisor_export_invoice" model="queue.job.function">
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_export_invoice</field>
        <field name="channel_id" ref="channel_netvisor_export_invoice" />
    </record>

    <record
        id="job_function_netvisor_netvisor_import_status"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_import_status</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <record
        id="job_function_netvisor_netvisor_export_status"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_export_status</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <!-- Credit notes -->
    <record id="job_function_netvisor_match_credit_note" model="queue.job.function">
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_match_credit_note</field>
        <field name="retry_pattern" eval="{1: 480, 2: 720, 3: 1440}" />
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <!-- Payments -->
    <record id="job_function_netvisor_import_payments" model="queue.job.function">
        <field name="model_id" ref="connector_netvisor.model_netvisor_payment" />
        <field name="method">netvisor_import_payments</field>
        <field name="retry_pattern" eval="{1: 480, 2: 720, 3: 1440}" />
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <!-- Customers -->
    <record
        id="job_function_netvisor_netvisor_export_customer"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_export_customer</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <record
        id="job_function_netvisor_netvisor_import_customer"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_import_customer</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <!-- Products -->
    <record
        id="job_function_netvisor_netvisor_export_product"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_export_product</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

    <record
        id="job_function_netvisor_netvisor_import_product"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_netvisor.model_netvisor_invoice" />
        <field name="method">netvisor_import_product</field>
        <field name="channel_id" ref="channel_netvisor" />
    </record>

</odoo>
