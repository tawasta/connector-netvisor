<?xml version="1.0" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.netvisor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button
                    invisible="not netvisor_send or state == 'posted'"
                    name="action_post"
                    string="Send to Netvisor"
                    class="oe_highlight"
                    type="object"
                    groups="account.group_account_invoice"
                    data-hotkey="q"
                    context="{'validate_analytic': True}"
                />
                <button
                    name="action_netvisor_export_invoice"
                    string="Send to Netvisor"
                    class="oe_highlight"
                    type="object"
                    groups="account.group_account_invoice"
                    invisible="not netvisor_send or state != 'posted' or netvisor_bind_ids"
                />
            </xpath>

            <xpath expr="//notebook/page[last()]" position="after">
                <page
                    string="Netvisor"
                    name="netvisor"
                    groups="account.group_account_invoice"
                >
                    <group col="1" groups="queue_job.group_queue_job_manager">
                        <button
                            name="action_netvisor_export_invoice"
                            string="Send to Netvisor"
                            class="oe_highlight"
                            type="object"
                            groups="account.group_account_invoice"
                            invisible="not netvisor_send or state != 'posted'"
                        />

                        <button
                            name="action_netvisor_import_status"
                            type="object"
                            class=""
                            invisible="state != 'posted'"
                            help="Update status from Netvisor"
                            string="Fetch status from Netvisor"
                        />

                        <button
                            name="action_netvisor_export_status"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'posted'"
                            help="Update status to Netvisor"
                            string="Send status to Netvisor"
                        />
                    </group>

                    <group>
                        <field
                            name="netvisor_send"
                            groups="account.group_account_invoice"
                            widget="boolean_toggle"
                        />
                        <field
                            name="netvisor_delayed_send"
                            groups="base.group_no_one"
                            widget="boolean_toggle"
                        />
                        <field name="netvisor_status" />
                    </group>

                    <label for="netvisor_bind_ids" />
                    <field name="netvisor_bind_ids" nolabel="1">
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="odoo_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
