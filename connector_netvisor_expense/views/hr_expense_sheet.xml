<?xml version="1.0" ?>
<odoo>
    <record id="view_hr_expense_sheet_form" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.netvisor</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_submit_sheet']" position="after">
                <field name="expenses_sent_to_netvisor" invisible="1" />
                <button
                    name="action_netvisor_export_expenses"
                    type="object"
                    class="oe_highlight"
                    string="Send to Netvisor"
                    invisible="state not in ['approve', 'post', 'done'] or expenses_sent_to_netvisor"
                />
            </xpath>
        </field>
    </record>
</odoo>
