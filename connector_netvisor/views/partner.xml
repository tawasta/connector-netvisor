<?xml version="1.0" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.netvisor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//page[@name='sales_purchases']//field[@name='user_id']"
                position="after"
            >
                <field name="email_invoicing_address" widget="email" />
            </xpath>

            <xpath expr="//notebook/page[last()]" position="after">
                <page
                    string="Netvisor"
                    name="netvisor"
                    groups="queue_job.group_queue_job_manager"
                >
                    <group>
                        <group colspan="2">
                            <field
                                name="netvisor_export"
                                widget="boolean_toggle"
                            />
                        </group>
                        <group>
                            <button
                                name="action_netvisor_export_record"
                                type="object"
                                class="oe_highlight"
                                string="Export to Netvisor"
                                invisible="not netvisor_export"
                                colspan="2"
                            />
                        </group>
                        <group>
                            <button
                                name="action_netvisor_import_customer"
                                type="object"
                                class=""
                                string="Update from Netvisor"
                                invisible="not netvisor_bind_ids"
                                colspan="2"
                            />
                        </group>
                    </group>

                    <label for="netvisor_bind_ids" />
                    <field name="netvisor_bind_ids" nolabel="1">
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="odoo_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
