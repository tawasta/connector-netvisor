<?xml version="1.0" ?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.netvisor</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <button name="action_post" position="after">
                <button
                    name="action_netvisor_export_record"
                    type="object"
                    class="oe_highlight"
                    string="Send to Netvisor"
                    invisible="netvisor_bind_ids or state != 'posted' or not netvisor_send"
                />
            </button>

            <group name="group2" position="after">
                <group name="netvisor" colspan="2">
                    <field name="netvisor_send" widget="boolean_toggle" />
                    <field name="netvisor_bind_ids" invisible="not netvisor_bind_ids">
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="odoo_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
