<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Netvisor purchase invoice posting data XML document
    -->
    <template id="netvisor_purchaseinvoicepostingdata">
        <root>
            <purchaseInvoicePostingData>
                <purchaseInvoiceNetvisorKey t-esc="invoice.external_id" />
                <status>approved</status>
                <eventDate format="ansi" t-esc="invoice.date.isoformat() or ''" />
                <isReadyForAccounting>0</isReadyForAccounting>
                <comment t-esc="invoice.description" />

                <t
                    t-set="invoice_lines"
                    t-value="invoice.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"
                />

                <purchaseInvoicePostingLine t-foreach="invoice_lines" t-as="line">
                    <purchaseInvoiceLineNetvisorKey
                        t-if="line.netvisor_key"
                        t-esc="line.netvisor_key"
                    />
                    <productCode t-esc="line.product_id.default_code or ''" />
                    <productName t-esc="line.name and line.name[0:200] or ''" />
                    <deliveredAmount
                        t-esc="line.quantity if invoice.move_type != 'in_refund' else line.quantity * -1"
                    />
                    <unitPrice t-esc="line.price_total / line.quantity" />
                    <discountPercentage t-esc="line.discount" />
                    <!-- TODO: Check for multiple tax on a line, the vatcode is taken from the first one -->
                    <vatPercent
                        t-att-vatcode="line.tax_ids[0].netvisor_code"
                        t-esc="sum(line.mapped('tax_ids.amount'))"
                    />
                    <lineSum type="gross" t-esc="round(line.price_total, 2)" />
                    <description t-esc="line.name" />
                    <sort t-esc="line.sequence" />
                    <accountingSuggestion t-esc="line.account_id.code or ''" />

                    <t t-if="line.analytic_distribution" id="dimension_wrapper">
                        <dimension
                            t-foreach="list(line.analytic_distribution.keys())[0].split(',')"
                            t-as="dimension"
                        >
                            <dimensionName
                                t-esc="dimensions[int(dimension)][0] or ''"
                            />
                            <dimensionItem
                                t-esc="dimensions[int(dimension)][1] or ''"
                            />
                        </dimension>
                    </t>
                </purchaseInvoicePostingLine>
            </purchaseInvoicePostingData>
        </root>
    </template>
</odoo>
