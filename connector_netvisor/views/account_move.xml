<?xml version="1.0" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.netvisor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button
                    name="action_post"
                    string="Send to Netvisor"
                    class="oe_highlight"
                    type="object"
                    groups="account.group_account_invoice"
                    data-hotkey="q"
                    context="{'validate_analytic': True}"
                    invisible="not netvisor_send or state == 'posted' or (netvisor_bind_ids and move_type in ('out_invoice', 'out_refund'))"
                />
                <button
                    name="action_netvisor_export_invoice"
                    string="Send to Netvisor"
                    class="oe_highlight"
                    type="object"
                    data-hotkey="q"
                    groups="account.group_account_invoice"
                    invisible="not netvisor_send or state != 'posted' or netvisor_bind_ids"
                />
            </xpath>

            <xpath expr="//notebook/page[last()]" position="after">
                <page
                    string="Netvisor"
                    name="netvisor"
                    groups="account.group_account_invoice"
                >
                    <group name="netvisor_action">
                        <group name="netvisor_action_settings" string="Settings">
                            <field
                                name="netvisor_send"
                                groups="account.group_account_invoice"
                                widget="boolean_toggle"
                            />
                            <field
                                name="netvisor_delayed_send"
                                groups="base.group_no_one"
                                widget="boolean_toggle"
                            />
                            <field name="netvisor_status" />

                            <field name="netvisor_sent" />
                            <div colspan="2">
                                <button
                                    name="action_reset_netvisor_sent"
                                    type="object"
                                    invisible="not netvisor_sent"
                                    help="Reset Netvisor sent state to allow resending"
                                    confirm="Are you sure you want reset the sent state?"
                                    string="Reset sent state"
                                    groups="queue_job.group_queue_job_manager"
                                />
                            </div>

                        </group>

                        <group name="netvisor_action_buttons" string="Actions" col="4">
                            <p class="oe_grey oe_inline" colspan="3">
                                Export invoice to Netvisor
                            </p>
                            <button
                                name="action_netvisor_export_invoice"
                                string="Export invoice"
                                class="oe_highlight"
                                type="object"
                                invisible="not netvisor_send or state != 'posted'"
                            />

                            <p class="oe_grey oe_inline" colspan="3">
                                Import invoice status from Netvisor to Odoo
                            </p>
                            <button
                                name="action_netvisor_import_status"
                                type="object"
                                class=""
                                invisible="state != 'posted'"
                                help="Update status from Netvisor"
                                string="Import status"
                                groups="queue_job.group_queue_job_manager"
                            />

                            <p class="oe_grey oe_inline" colspan="3">
                                Export invoice status from Odoo to Netvisor
                            </p>
                            <button
                                name="action_netvisor_export_status"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'posted'"
                                help="Update status to Netvisor"
                                string="Export status"
                            />

                            <p
                                class="oe_grey oe_inline"
                                colspan="3"
                                invisible="not netvisor_bind_ids"
                            >
                                Unlink Netvisor invoice. This is irreversible!
                            </p>
                            <button
                                name="action_netvisor_unlink"
                                confirm="Are you sure you want unlink the Netvisor invoice? This can't be undone."
                                type="object"
                                class="btn btn-danger"
                                invisible="not netvisor_bind_ids"
                                help="Unlink Netvisor invoice"
                                string="Unlink invoice"
                            />
                        </group>
                    </group>

                    <label for="netvisor_bind_ids" />
                    <field name="netvisor_bind_ids" nolabel="1">
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="odoo_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
