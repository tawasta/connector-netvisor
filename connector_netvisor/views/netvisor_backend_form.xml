<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_netvisor_backend_form" model="ir.ui.view">
        <field name="name">Netvisor backend form</field>
        <field name="model">netvisor.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Test authentication"
                            type="object"
                            name="action_test_authentication"
                            groups="base.group_system"
                            help="Test authentication by fetching the customer list"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">

                    </div>

                    <group>
                        <group name="settings" string="Setting">
                            <field name="company_id"/>
                            <field name="partner"/>
                            <field name="partner_key"/>
                            <field name="customer"/>
                            <field name="customer_key"/>
                            <field name="language"/>

                        </group>
                    </group>

                  <notebook>
                    <page name="import" string="Imports" >
                      <p class="oe_grey oe_inline">
                          You can initiate importing records here.
                          <br/>Please be aware that this can overwrite information in Odoo.
                      </p>
                      <group name="customers" string="Customers" colspan="2">
                        <p class="oe_grey oe_inline">
                            Import or update all customers from Netvisor.<br />
                            If customer doesn't exist, one will be created.
                            If customer exists (business id or exact name match), it will be updated.
                        </p>
                        <button name="action_import_customers"
                          type="object"
                          class="oe_highlight"
                          string="Import customers"/>
                      </group>

                      <group name="suppliers" string="Suppliers" colspan="2" invisible="1">
                        <p class="oe_grey oe_inline">
                            Import or update all suppliers from Netvisor.<br />
                            If suppliers doesn't exist, one will be created.
                            If suppliers exists (business id or exact name match), it will be updated.
                        </p>
                        <button name="action_import_suppliers"
                          type="object"
                          class="oe_highlight"
                          string="Import suppliers"/>
                      </group>

                      <group name="products" string="Products" colspan="2">
                        <p class="oe_grey oe_inline">
                            Import or update all products from Netvisor.<br />
                            If product doesn't exist, one will be created.
                            If product exists (internal code or exact name match), it will be updated.
                        </p>
                        <button name="action_import_products"
                          type="object"
                          class="oe_highlight"
                          string="Import products"/>

                        <p class="oe_grey oe_inline">
                            Export or update all products to Netvisor.<br />
                            If product doesn't exist, one will be created.
                            If product exists (binding exists), it will be updated.
                        </p>
                        <button name="action_export_products"
                          type="object"
                          class="oe_highlight"
                          string="Export products"/>
                      </group>

                    </page>
                  </notebook>

                </sheet>

            </form>
        </field>
    </record>
</odoo>
