<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Netvisor sales payment XML document
    -->
    <template id="netvisor_sales_payment">
        <root>
            <salespayment>
                <sum
                    t-esc="record.amount"
                    t-att-currency="record.currency_id.name"
                />
                <paymentdate t-esc="record.date.isoformat()" />

                <t
                    t-if="record.reconciled_invoice_ids"
                    t-set="identifier"
                    t-value="record.reconciled_invoice_ids[0].payment_reference"
                />
                <t
                    t-elif="record.payment_transaction_id"
                    t-set="identifier"
                    t-value="record.payment_transaction_id.payment_reference"
                />
                <t t-else="" t-set="identifier" t-value="record.ref" />

                <targetidentifier
                    t-esc="identifier"
                    type="reference"
                    targettype="invoice"
                />

                <sourcename t-esc="record.name" />
                <paymentmethod
                    t-esc="record.payment_method_line_id.payment_method_id.name"
                    type="alternative"
                />
            </salespayment>
        </root>
    </template>
</odoo>
