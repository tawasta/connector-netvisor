<?xml version="1.0" ?>
<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.netvisor</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page
                    string="Netvisor"
                    name="netvisor"
                    groups="queue_job.group_queue_job_manager"
                >
                    <group>
                        <button
                            name="action_netvisor_export_record"
                            type="object"
                            class="oe_highlight"
                            string="Send to Netvisor"
                        />
                        <button
                            name="action_netvisor_import_record"
                            type="object"
                            class=""
                            string="Update from Netvisor"
                            invisible="not netvisor_bind_ids"
                        />
                    </group>

                    <label for="netvisor_bind_ids" />
                    <field name="netvisor_bind_ids" nolabel="1">
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="odoo_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
