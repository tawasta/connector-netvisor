<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="netvisor_salesinvoice"
        inherit_id="connector_netvisor.netvisor_salesinvoice"
    >
        <xpath
            expr="//salesInvoiceProductLine//t[@id='dimension_wrapper']"
            position="after"
        >
            <accrualrule t-if="line.accrual_rule_id">
                <startmonth
                    t-esc="line.accrual_rule_id.get_accrual_start_month(invoice.invoice_date)"
                />
                <startyear
                    t-esc="line.accrual_rule_id.get_accrual_start_year(invoice.invoice_date)"
                />
                <endmonth
                    t-esc="line.accrual_rule_id.get_accrual_end_month(invoice.invoice_date)"
                />
                <endyear
                    t-esc="line.accrual_rule_id.get_accrual_end_year(invoice.invoice_date)"
                />
            </accrualrule>
        </xpath>
    </template>
</odoo>
